APP_NAME="DogeOW Repo Watch API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8012
FRONTEND_URL=http://localhost:3012

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Repo Watch 只有这一条业务 SQL 连接；中央账号不会读取本数据库。
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=repo_watch
DB_USERNAME=repo_watch
DB_PASSWORD=

# 独立 HttpOnly 会话，不与 next.dogeow.com 共用 cookie 或 APP_KEY。
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=repo_watch_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE=repo-watch
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=14
REDIS_CACHE_DB=15
REDIS_SESSION_DB=13
REDIS_PREFIX=repo-watch:

IDENTITY_API_URL=http://127.0.0.1
IDENTITY_SSO_CLIENT_SECRET=

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPO_WATCH_REFRESH_HOURS=6
GITHUB_REPO_WATCH_SCAN_INTERVAL_HOURS=6
GITHUB_REPO_WATCH_SCAN_BATCH_SIZE=5
GITHUB_REPO_WATCH_SCAN_DELAY_MS=750
GITHUB_REPO_WATCH_RATE_LIMIT_FLOOR=50
GITHUB_REPO_WATCH_SCAN_RETRY_SECONDS=300
GITHUB_REPO_WATCH_SCANNING_STALE_MINUTES=20
GITHUB_REPO_WATCH_SNAPSHOT_KEEP=10
GITHUB_REPO_WATCH_CHANGE_RETENTION_DAYS=90

# High-signal dependency notifications (in-app always when enabled; webhook only if URL set)
REPO_WATCH_NOTIFY_ENABLED=true
REPO_WATCH_NOTIFY_WEBHOOK_URL=
REPO_WATCH_NOTIFY_ON_MAJOR=true
REPO_WATCH_NOTIFY_ON_REMOVED=true
REPO_WATCH_NOTIFY_ON_SCAN_FAILURE=true
REPO_WATCH_NOTIFY_ON_ADVISORY=true

# Package advisories via OSV (does not consume GitHub API budget)
REPO_WATCH_ADVISORY_ENABLED=true
REPO_WATCH_ADVISORY_MIN_SEVERITY=high
REPO_WATCH_ADVISORY_QUERY_BATCH_SIZE=80
REPO_WATCH_OSV_BASE_URL=https://api.osv.dev

MAIL_MAILER=log
MAIL_FROM_ADDRESS="repo-watch@dogeow.com"
MAIL_FROM_NAME="${APP_NAME}"
